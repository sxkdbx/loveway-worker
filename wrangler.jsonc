{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loveway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // 静态资源（MDUI、jQuery、CSS、字体等）。命中静态文件直接返回，未命中交给 Worker。
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },

  // D1 数据库（替代原项目的 MySQL）。
  // 部署前先执行：
  //   wrangler d1 create loveway
  // 然后把输出的 database_id 填到下面。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loveway",
      "database_id": "5baf5095-f133-49e1-9f43-dcb8d389b26e"
    }
  ],

  // KV 命名空间（存储表白配图，替代原项目的本地图片上传 static/uploads）。
  // 部署前先执行：
  //   wrangler kv namespace create UPLOADS
  // 然后把输出的 id 填到下面。
  // 不需要图片上传功能时，可删除本段并把 vars.UPLOAD_IMAGE 改为 "false"。
  "kv_namespaces": [
    {
      "binding": "UPLOADS",
      "id": "bc7e4cebf4dc4a09b370ec5b6e80c980"
    }
  ],

  // 站点配置（可直接修改；管理员密码建议改用 secret，见 README）。
  "vars": {
    "ADMIN_USER": "kagamine",
    "ADMIN_PASS": "kagamine1234",
    "VERIFICATION_KEY": "KAGAMINE YES!",
    "PAGEMAX": "10",
    "MAX_UPLOAD_SIZE": "200",
    "UPLOAD_IMAGE": "true"
  }
}
