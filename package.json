{
  "name": "loveway",
  "version": "1.5.9-worker.1",
  "private": true,
  "description": "未知表白墙 - Cloudflare Workers 版本",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute loveway --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute loveway --remote --file=./schema.sql",
    "kv:init": "wrangler kv namespace create UPLOADS"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.142.0"
  }
}
